# evalcode environment template.
# Copy to `.env` and fill in:  copy .env.example .env
# `.env` is git-ignored — never commit your real key.
# Blank values fall back to the defaults below.

# --- OpenRouter / LLM ---

# Get a free key at https://openrouter.ai/keys; never commit the real .env
OPENROUTER_API_KEY=

# Default base URL for the OpenAI-compatible OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free model slug; blank = default qwen/qwen3.8-27b:free (alternatives e.g. qwen/qwen3-coder:free)
LLM_MODEL=

# Sampling temperature
LLM_TEMPERATURE=0.2

# Max output tokens per completion (caps reasoning-model token burn)
LLM_MAX_TOKENS=8192

# Per-request timeout in seconds
LLM_TIMEOUT_S=120

# Retries per LLM call on transient errors (429/408/5xx/timeout/empty)
LLM_MAX_API_RETRIES=5

# Exponential backoff base in seconds
LLM_BACKOFF_BASE_S=2.0

# Backoff cap in seconds
LLM_BACKOFF_MAX_S=60.0

# Give up (DailyQuotaExceeded) if a required wait exceeds this many seconds
LLM_MAX_WAIT_S=120.0

# Minimum seconds between LLM calls (free-tier per-minute throttling)
LLM_MIN_INTERVAL_S=3.0

# Hard cap on logical LLM calls per run
MAX_LLM_CALLS_PER_RUN=10

# --- Embeddings & vector store ---

# Local embedding model (downloaded once, CPU-only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chroma persistent client directory
CHROMA_DIR=data/chroma

# Chroma collection name
COLLECTION_NAME=python_docs

# Comma-separated libraries to introspect at ingest time
DOC_LIBRARIES=json,re,datetime,collections,itertools,pathlib,dataclasses,csv,sqlite3,argparse,pandas,numpy

# Directory for optional local .md/.rst/.txt doc files
DOCS_DIR=data/docs

# --- Agent budgets / persistence ---

# LangGraph SQLite checkpointer database (resume across CLI invocations)
CHECKPOINT_DB=data/checkpoints.sqlite

# Run logs directory
LOG_DIR=logs

# Automatic (test-failure-driven) revisions per round
MAX_RETRIES=3

# Human-requested revisions before the run fails
MAX_HUMAN_ROUNDS=2

# --- Sandbox ---

# Wall-clock timeout in seconds for sandboxed test runs
SANDBOX_TIMEOUT_S=10

# Memory limit in MB for sandboxed test runs (POSIX only; skipped on Windows)
SANDBOX_MEM_MB=1024

# --- Retrieval ---

# Chroma top-k per query
RETRIEVAL_TOP_K=5

# Max docs kept in state after merging/dedup
RETRIEVAL_MAX_DOCS=8

# Drop documents scoring below this cosine similarity
RETRIEVAL_MIN_SCORE=0.2

# Cap on injected doc context in prompts (chars)
CONTEXT_MAX_CHARS=6000

# Optional LLM error diagnosis (off by default: deterministic parsing always runs)
ANALYZE_WITH_LLM=false

# Optional LLM query rewrite (off by default: raw task text is used)
QUERY_REWRITE_WITH_LLM=false

# --- LangSmith (off by default; needs its own key when enabled) ---

LANGSMITH_TRACING=false

LANGSMITH_API_KEY=

LANGSMITH_PROJECT=evalcode
